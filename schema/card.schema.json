{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "mechanisms",
    "problem",
    "failure",
    "correction",
    "transfer",
    "limits",
    "source",
    "status",
    "author",
    "extractor"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "mechanisms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "problem": {
      "type": "string"
    },
    "failure": {
      "type": "string"
    },
    "correction": {
      "type": "string"
    },
    "transfer": {
      "type": "string"
    },
    "limits": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "url",
        "visibility"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "visibility": {
          "enum": [
            "public",
            "explicitly-cleared"
          ]
        },
        "revision": {
          "type": "string"
        }
      }
    },
    "status": {
      "enum": [
        "SOURCE_ONLY",
        "USER_REPORTED",
        "VERIFIED_BOUNDED",
        "UNRESOLVED"
      ]
    },
    "author": {
      "type": "string"
    },
    "extractor": {
      "type": "string"
    },
    "verifier": {
      "type": "string"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}